---
import Layout from '../../layouts/Layout.astro'
import Section from '../../components/layout/Section.astro'
import Footer from '../../components/layout/Footer.astro'
import Navbar from '../../components/layout/Navbar'
import type { MarkdownPost } from '../../data/types'

const posts = Object.values(
  import.meta.glob<MarkdownPost>('./*.md', { eager: true }),
)

const sortedPosts = posts.sort(
  (a, b) =>
    new Date(b.frontmatter.date).valueOf() -
    new Date(a.frontmatter.date).valueOf(),
)
---

<Layout title="Engineering Notes | Adarsh">
  <Navbar client:load />

  <Section
    id="blog-archive"
    title="Engineering Notes"
    heading="Writing & thoughts"
  >
    <p
      class="mb-10 max-w-2xl text-[14px] leading-relaxed text-[var(--ink-muted)]"
    >
      Articles on Web3, React, scalable systems architecture, and my journey as
      a developer.
    </p>

    <div class="space-y-0">
      {
        sortedPosts.map((post, i) => (
          <a
            href={post.url}
            class="group row-hover-sheen focus-ink -mx-4 block border-b border-[var(--ink-faint)] px-4 py-5"
          >
            <span
              class="row-hover-sheen__fill"
              aria-hidden="true"
            />
            <div class="relative z-10 flex items-center justify-between gap-6">
              <div class="min-w-0 flex-1">
                <div class="mb-1.5 flex flex-wrap items-center gap-x-3 gap-y-1">
                  <span class="shrink-0 font-mono text-[10px] font-medium tracking-[0.18em] text-[var(--ink)] uppercase">
                    Note / {String(sortedPosts.length - i).padStart(3, '0')}
                  </span>
                  <span class="hidden font-mono text-[10px] tracking-[0.12em] text-[var(--ink-muted)] uppercase sm:inline">
                    {post.frontmatter.category || 'Article'}
                  </span>
                </div>
                <h3 class="truncate text-[15px] font-medium text-[var(--ink-deep)] transition-colors group-hover:text-[var(--ink)]">
                  {post.frontmatter.title}
                </h3>
                <p class="mt-1 truncate text-[13px] leading-relaxed text-[var(--ink-muted)]">
                  {post.frontmatter.description}
                </p>
              </div>
              <div class="flex shrink-0 flex-col items-end gap-2">
                <span class="hidden font-mono text-[11px] text-[var(--ink-muted)] md:block">
                  {new Date(post.frontmatter.date).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </span>
                <span class="sketch-link font-mono text-[10px] tracking-[0.12em] uppercase">
                  → Read
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </Section>

  <Footer />
</Layout>
