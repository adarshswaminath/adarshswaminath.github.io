---
import Layout from '../layouts/Layout.astro'
import TracingBeam from '../components/layout/TracingBeam.astro'
import Navbar from '../components/layout/Navbar'
import Footer from '../components/layout/Footer.astro'
import {
  Hero,
  About,
  Projects,
  Experience,
  BlogPreview,
  Contact,
} from '../components/sections/home-page'
import { SketchDivider } from '../components/sketch'
import type { MarkdownPost } from '../data/types'

const posts = Object.values(
  import.meta.glob<MarkdownPost>('./blog/*.md', { eager: true }),
)
const featuredBlogs = posts
  .sort(
    (a, b) =>
      new Date(b.frontmatter.date).valueOf() -
      new Date(a.frontmatter.date).valueOf(),
  )
  .slice(0, 4)
---

<Layout>
  <div
    class="relative mx-3 mt-2.5 border border-(--ink)/45 bg-(--paper) lg:mx-4 lg:mt-3.5"
  >
    <Navbar client:load />
    <Hero />
  </div>
  <TracingBeam />
  <SketchDivider />
  <Projects />
  <SketchDivider />
  <About />
  <SketchDivider />
  <Experience />
  <SketchDivider />
  <BlogPreview posts={featuredBlogs} />
  <SketchDivider />
  <Contact />
  <Footer />
</Layout>

<script>
  import { setupTyping } from '../scripts/typing'
  import { setupTracingBeam } from '../scripts/tracing-beam'
  import { setupDrawer } from '../scripts/drawer'

  setupTyping()
  setupTracingBeam()
  setupDrawer()

  document.addEventListener('astro:page-load', () => {
    setupTyping()
    setupTracingBeam()
    setupDrawer()
  })
</script>
