---
import Layout from '../layouts/Layout.astro'
import TracingBeam from '../components/layout/TracingBeam.astro'
import ExpeditionTrail from '../components/layout/ExpeditionTrail.astro'
import Navbar from '../components/layout/Navbar'
import Footer from '../components/layout/Footer.astro'
import {
  Hero,
  About,
  Projects,
  Experience,
  BlogPreview,
  Contact,
} from '../components/sections/home-page'
import { SketchDivider } from '../components/sketch'
import type { MarkdownPost } from '../data/types'

const posts = Object.values(
  import.meta.glob<MarkdownPost>('./blog/*.md', { eager: true }),
)
const featuredBlogs = posts
  .sort(
    (a, b) =>
      new Date(b.frontmatter.date).valueOf() -
      new Date(a.frontmatter.date).valueOf(),
  )
  .slice(0, 4)
---

<Layout>
  <ExpeditionTrail />
  <div class="relative z-10">
    <div
      class="relative mx-3 mt-2.5 border border-(--ink)/45 bg-(--paper) lg:mx-4 lg:mt-3.5"
    >
      <Navbar client:load />
      <Hero />
    </div>
    <TracingBeam />
    <SketchDivider flagFor="projects" />
    <Projects />
    <SketchDivider flagFor="about" />
    <About />
    <SketchDivider flagFor="experience" />
    <Experience />
    <SketchDivider flagFor="blog" />
    <BlogPreview posts={featuredBlogs} />
    <SketchDivider flagFor="contact" />
    <Contact />
    <Footer />
  </div>
</Layout>

<script>
  import { setupTyping } from '../scripts/typing'
  import { setupTracingBeam } from '../scripts/tracing-beam'
  import { setupExpeditionTrail } from '../scripts/expedition-trail'
  import { setupDrawer } from '../scripts/drawer'
  import { setupTreasureChest } from '../scripts/treasure-chest'

  setupTyping()
  setupTracingBeam()
  setupExpeditionTrail()
  setupDrawer()
  setupTreasureChest()

  document.addEventListener('astro:page-load', () => {
    setupTyping()
    setupTracingBeam()
    setupExpeditionTrail()
    setupDrawer()
    setupTreasureChest()
  })
</script>
