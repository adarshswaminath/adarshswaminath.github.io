---
import '../styles/global.css'
import { ClickSpark } from '../components/ui'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Adarsh Swaminath - Portfolio',
  description =
    'Frontend-focused full-stack engineer. Field notes on interfaces, systems, AI, and developer tooling.',
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <meta
      name="google-site-verification"
      content="xDtl1J1YesgmipXRZY2wtkc6Eky8YQruopfQ2LemW1M"
    />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
    <meta
      property="og:image"
      content="/og-image.png"
    />
    <meta
      property="twitter:image"
      content="/og-image.png"
    />
    <meta
      name="generator"
      content={Astro.generator}
    />
    <title>{title}</title>
    <meta
      name="description"
      content={description}
    />
    <style is:global>
      body {
        font-family: var(--font-sans);
        font-optical-sizing: auto;
        font-weight: 400;
        font-style: normal;
      }
      pre,
      code {
        font-family: var(--font-mono);
      }
    </style>
  </head>
  <body class="relative min-h-screen text-(--ink-deep) antialiased">
    <!-- Notebook margin gutters -->
    <div
      class="pointer-events-none fixed inset-0 z-0 flex justify-center"
      aria-hidden="true"
    >
      <div class="relative h-full w-full max-w-5xl">
        <div
          class="absolute top-0 bottom-0 left-3 hidden w-px bg-(--ink-faint) sm:block md:left-0"
        >
        </div>
        <div
          class="absolute top-0 bottom-0 right-3 hidden w-px bg-(--ink-faint) sm:block md:right-0"
        >
        </div>
      </div>
    </div>
    <div class="relative z-10 w-full overflow-x-hidden">
      <slot />
    </div>
    <ClickSpark />
  </body>
</html>
