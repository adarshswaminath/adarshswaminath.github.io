---
import Layout from './Layout.astro'
import Section from '../components/layout/Section.astro'
import Navbar from '../components/layout/Navbar'
import Footer from '@/components/layout/Footer.astro'
import { SketchUnderline } from '../components/sketch'

const { frontmatter } = Astro.props
---

<Layout
  title={`${frontmatter.title} — Adarsh Notes`}
  description={frontmatter.description}
>
  <Navbar client:load />

  <Section
    id="article"
    title={frontmatter.category || 'Engineering Note'}
    heading={frontmatter.title}
  >
    <div class="mb-8 border-b border-[var(--ink-faint)] pb-4">
      <div class="flex flex-wrap items-center gap-3 font-mono text-[12px] text-[var(--ink-muted)]">
        <time datetime={frontmatter.date}
          >{
            new Date(frontmatter.date).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })
          }</time
        >
        {
          frontmatter.author && (
            <>
              <span aria-hidden="true">·</span>
              <span>{frontmatter.author}</span>
            </>
          )
        }
      </div>
      <SketchUnderline
        class="mt-3 opacity-60"
        width={100}
      />
    </div>

    <article class="prose mx-auto max-w-3xl min-w-0">
      <slot />
    </article>

    <p class="mt-12">
      <a
        href="/blog"
        class="sketch-link focus-ink font-mono text-[12px] tracking-[0.14em] uppercase"
      >
        ← Back to notes
      </a>
    </p>
  </Section>

  <Footer />
</Layout>
