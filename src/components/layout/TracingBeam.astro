---
/**
 * Rethemed tracing beam — blue ink margin line.
 * Visually starts at #projects (positioned by tracing-beam.ts).
 */
---

<div
  id="tracing-beam"
  class="pointer-events-none fixed inset-y-0 z-40 flex w-full justify-center opacity-0 transition-opacity duration-300"
  aria-hidden="true"
>
  <div class="relative h-full w-full max-w-5xl">
    <div
      id="tracing-beam-rail"
      class="absolute bottom-0 left-4 hidden w-[2px] sm:block md:left-[0.01rem]"
      style="top: 100vh"
    >
      <div
        id="tracing-beam-dot"
        class="absolute -top-5 -left-[6px] flex h-3.5 w-3.5 items-center justify-center rounded-full border border-[var(--ink)] bg-[var(--paper)] transition-all duration-300"
      >
        <div
          id="tracing-beam-inner-dot"
          class="h-1.5 w-1.5 rounded-full bg-[var(--ink)] transition-colors duration-300"
        >
        </div>
      </div>

      <svg
        class="h-full w-full overflow-visible"
        preserveAspectRatio="none"
        viewBox="0 0 2 100"
      >
        <line
          x1="1"
          y1="0"
          x2="1"
          y2="100"
          stroke="var(--ink-muted)"
          stroke-opacity="0.25"
          stroke-width="1.25"
          vector-effect="non-scaling-stroke"
          stroke-linecap="round"
        ></line>

        <line
          x1="1"
          y1="0"
          x2="1"
          y2="100"
          stroke="url(#tracing-gradient)"
          stroke-width="1.75"
          vector-effect="non-scaling-stroke"
          stroke-linecap="round"
        ></line>

        <defs>
          <linearGradient
            id="tracing-gradient"
            gradientUnits="userSpaceOnUse"
            x1="0"
            x2="0"
            y1="0"
            y2="-25"
          >
            <stop
              stop-color="#174A91"
              stop-opacity="0"
            ></stop>
            <stop stop-color="#174A91"></stop>
            <stop
              offset="0.325"
              stop-color="#6383B0"
            ></stop>
            <stop
              offset="1"
              stop-color="#6383B0"
              stop-opacity="0"
            ></stop>
          </linearGradient>
        </defs>
      </svg>
    </div>
  </div>
</div>
