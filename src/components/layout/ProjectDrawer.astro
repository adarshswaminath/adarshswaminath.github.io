---
// ProjectDrawer notebook case-study panel
import { ArrowUpRight, X, Github } from 'lucide-astro'
import { MetaLabel } from '../ui'
import type { Project } from '../../data/types'

interface Props {
  projects: Project[]
}

const { projects } = Astro.props
---

<div
  id="project-drawer-overlay"
  class="fixed inset-0 z-100 hidden"
>
  <div
    id="drawer-backdrop"
    class="drawer-backdrop absolute inset-0 cursor-pointer bg-[color-mix(in_srgb,var(--ink-deep)_35%,transparent)]"
  >
  </div>

  <div
    id="drawer-panel"
    class="drawer-panel absolute top-0 right-0 bottom-0 w-full max-w-3xl overflow-y-auto bg-(--paper)"
    role="dialog"
    aria-modal="true"
    aria-label="Field note details"
  >
    <button
      id="drawer-close-btn"
      type="button"
      aria-label="Close field note"
      class="focus-ink sticky top-0 z-20 flex w-full items-center justify-between border-b border-(--ink-faint) bg-(--paper) px-6 pt-5 pb-4 md:px-8"
      style="background-color: var(--paper)"
    >
      <MetaLabel>Field Note / Case Study</MetaLabel>
      <span
        class="flex h-8 w-8 items-center justify-center border border-(--ink-faint) transition-colors hover:border-(--ink)"
        aria-hidden="true"
      >
        <X
          size={16}
          class="text-(--ink-muted)"
        />
      </span>
    </button>

    {
      projects.map((p, i) => (
        <div
          class="drawer-content relative z-0 hidden px-6 py-4 pb-14 md:px-8"
          data-project-index={i}
        >
          <div class="mb-8">
            <p class="mb-2 font-mono text-[10px] tracking-[0.2em] text-(--ink-muted) uppercase">
              Note / {String(i + 1).padStart(3, '0')}
            </p>
            <h2 class="font-display mb-3 text-2xl tracking-tight text-(--ink-deep) md:text-3xl">
              {p.title}
            </h2>
            <p class="mb-5 text-[15px] leading-relaxed text-(--ink-muted)">
              {p.desc}
            </p>
            <div class="mb-5 flex flex-wrap gap-1.5">
              {p.tech.map((t) => (
                <span class="border border-(--ink-faint) bg-(--paper-dark) px-2 py-0.5 font-mono text-[11px] tracking-tight text-(--ink-muted)">
                  {t}
                </span>
              ))}
            </div>

            <div class="flex gap-3">
              {p.github && (
                <a
                  href={p.github}
                  target="_blank"
                  rel="noopener"
                  class="sketch-link focus-ink group flex items-center gap-1.5 font-mono text-[12px] tracking-wide uppercase"
                >
                  <Github size={14} />
                  Source
                  <ArrowUpRight
                    size={12}
                    class="opacity-60"
                  />
                </a>
              )}
            </div>
          </div>

          <div class="mb-8 h-px bg-(--ink-faint)" />

          {p.problem && (
            <div class="mb-8">
              <MetaLabel class="mb-3">Problem</MetaLabel>
              <p class="text-[14px] leading-relaxed text-(--ink-deep)/80">
                {p.problem}
              </p>
            </div>
          )}

          {p.solution && (
            <div class="mb-8">
              <MetaLabel class="mb-3">Solution</MetaLabel>
              <p class="text-[14px] leading-relaxed text-(--ink-deep)/80">
                {p.solution}
              </p>
            </div>
          )}

          {p.features && p.features.length > 0 && (
            <div class="mb-8">
              <MetaLabel class="mb-4">Core Features</MetaLabel>
              <div class="space-y-3">
                {p.features.map((feature) => (
                  <div class="flex items-start gap-3">
                    <span
                      class="mt-[0.6rem] h-px w-3 shrink-0 bg-(--ink)/50"
                      aria-hidden="true"
                    />
                    <span class="text-[14px] leading-relaxed text-(--ink-deep)/80">
                      {feature}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          )}

          {p.architecture && (
            <div class="mb-8">
              <MetaLabel class="mb-3">Architecture</MetaLabel>
              <p class="mb-2 font-mono text-[10px] tracking-wide text-(--ink-muted) uppercase select-none">
                Drag to pan · Scroll or pinch to zoom
              </p>
              <div class="architecture-mermaid relative h-[min(70vh,28rem)] w-full overflow-hidden border border-(--ink-faint) bg-(--paper-dark)/40 p-3 select-none [&_.mermaid]:flex [&_.mermaid]:min-h-full [&_.mermaid]:w-full [&_.mermaid]:items-center [&_.mermaid]:justify-center [&_svg]:max-w-none">
                <div class="mermaid text-[13px] leading-snug text-(--ink-deep)">
                  {p.architecture}
                </div>
              </div>
            </div>
          )}

          {p.impact && p.impact.length > 0 && (
            <div class="mb-8">
              <MetaLabel class="mb-4">Impact</MetaLabel>
              <div class="space-y-3">
                {p.impact.map((item) => (
                  <div class="flex items-start gap-3">
                    <span
                      class="mt-[0.6rem] h-px w-3 shrink-0 bg-(--ink-muted)/60"
                      aria-hidden="true"
                    />
                    <span class="text-[14px] leading-relaxed text-(--ink-deep)/80">
                      {item}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          )}

          <div class="mt-8 border-t border-(--ink-faint) pt-6">
            <div class="border border-(--ink-faint) bg-(--paper-dark)/50 p-4">
              <MetaLabel class="mb-2">Highlight</MetaLabel>
              <p class="text-[13px] font-medium text-(--ink-deep)">
                {p.highlight}
              </p>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</div>
