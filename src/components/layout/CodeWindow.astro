---
import type { CodeLanguage } from 'astro'
import { Code } from 'astro:components'
import { SketchBorder } from '../sketch'

interface Props {
  title?: string
  code: string
  lang?: CodeLanguage
  class?: string
}

const {
  title = 'stack.ts',
  code,
  lang = 'typescript',
  class: className = '',
} = Astro.props
---

<div class={`relative ${className}`}>
  <div
    class="relative overflow-hidden bg-[color-mix(in_srgb,var(--paper-dark)_55%,white)]"
  >
    <SketchBorder />
    <div
      class="relative flex items-center border-b border-(--ink-faint) px-4 py-2.5"
    >
      <span class="font-mono text-[11px] tracking-wide text-(--ink-muted)"
        >{title}</span
      >
      <span
        class="font-hand ml-auto text-sm text-(--ink) opacity-80"
        aria-hidden="true">terminal</span
      >
    </div>
    <div
      class="code-window-body flex-1 overflow-x-auto p-5 font-mono text-sm md:p-6"
    >
      <Code
        code={code}
        lang={lang}
        theme="github-light"
      />
    </div>
  </div>
</div>

<style is:global>
  .code-window-body pre {
    background-color: transparent !important;
    margin: 0;
    padding: 0;
    font-family: inherit;
  }
</style>
