---
/**
 * Notebook section shell shared kicker + editorial heading.
 * Keep markup boring; sections own their compositions.
 */
import { SketchUnderline } from '../sketch'

interface Props {
  id?: string
  /** Mono label, e.g. "Field Notes / 002" */
  kicker: string
  heading: string
}

const { id, kicker, heading } = Astro.props
---

<section
  id={id}
  class="relative overflow-visible py-16 md:py-20 lg:py-24"
>
  <slot name="margin" />
  <div class="mx-auto max-w-5xl px-6">
    <header class="mb-10 md:mb-12">
      <p
        class="mb-3 font-mono text-[10px] tracking-[0.22em] text-(--ink-muted) uppercase"
      >
        {kicker}
      </p>
      <div class="relative inline-block">
        <h2
          class="font-display text-[1.85rem] leading-[1.15] tracking-tight text-(--ink-deep) md:text-[2.15rem]"
        >
          {heading}
        </h2>
        <SketchUnderline
          class="mt-1.5 opacity-70"
          width={140}
        />
      </div>
    </header>
    <slot />
  </div>
</section>
