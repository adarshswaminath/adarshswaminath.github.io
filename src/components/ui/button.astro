---
/**
 * Ink-styled interactive button
 */
import { ArrowRight } from 'lucide-astro'
import { cn } from '@/lib/utils'

export interface Props {
  primary?: boolean
  href?: string
  class?: string
}

const { primary, href, class: className = '' } = Astro.props as Props

const Tag = href ? 'a' : 'button'
const labelHtml = Astro.slots.has('default')
  ? await Astro.slots.render('default')
  : ''
---

<Tag
  href={href}
  {...!href ? ({ type: 'button' } as const) : {}}
  class={cn(
    'interactive-hover-btn group focus-ink relative inline-flex min-h-11 w-auto cursor-pointer select-none overflow-hidden border text-center text-[14px] font-semibold antialiased transition-colors duration-300',
    primary
      ? 'border-(--ink) bg-(--ink) text-(--paper) hover:bg-(--ink-deep)'
      : 'border-(--ink) bg-(--paper) text-(--ink) hover:bg-(--paper-dark)',
    className,
  )}
>
  <div
    class="relative z-0 flex min-h-11 items-center justify-center gap-2.5 px-7 py-2.5"
  >
    <span
      class={cn(
        'h-1.5 w-1.5 shrink-0 rounded-full transition-opacity duration-300 group-hover:opacity-0',
        primary ? 'bg-(--paper)' : 'bg-(--ink)',
      )}
      aria-hidden="true"
    ></span>
    <span
      class={cn(
        'interactive-hover-btn__label inline-block transition-all duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] will-change-[transform,opacity]',
        'group-hover:translate-x-11 group-hover:opacity-0',
      )}
      set:html={labelHtml}
    />
  </div>

  <div
    class={cn(
      'absolute inset-0 z-10 flex items-center justify-center gap-2.5 px-7 text-nowrap opacity-0 transition-all duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] will-change-[transform,opacity]',
      'translate-x-11 group-hover:translate-x-0 group-hover:opacity-100',
    )}
    aria-hidden="true"
  >
    <span
      class="inline-block"
      set:html={labelHtml}
    />
    <ArrowRight
      size={16}
      class="shrink-0"
      aria-hidden="true"
    />
  </div>
</Tag>
