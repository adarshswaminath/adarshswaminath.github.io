---
// tag.astro — notebook-style tech tag
interface Props {
  class?: string
}
const { class: className = '' } = Astro.props
---

<span
  class={`border border-[var(--ink-faint)] bg-[var(--paper-dark)] px-2 py-0.5 font-mono text-[11px] tracking-tight text-[var(--ink-muted)] ${className}`}
>
  <slot />
</span>
