---
// section-divider.astro — kept for compatibility; prefer SketchDivider
interface Props {
  className?: string
}
const { className = '' } = Astro.props
---

<div
  class={`mx-auto w-full max-w-5xl border-y border-[var(--ink-faint)] ${className}`}
>
  <div
    class="h-6 w-full opacity-[0.08]"
    style="background-image:repeating-linear-gradient(-45deg, transparent, transparent 2px, var(--ink) 2px, var(--ink) 3px, transparent 3px, transparent 6px)"
  >
  </div>
</div>
