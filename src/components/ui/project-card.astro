---
/**
 * Compact notebook project card equal height, SVG diagram, opens drawer.
 */
import type { Project } from '../../data/types'
import ProjectDiagram from './ProjectDiagram.astro'

interface Props {
  project: Project
  index: number
  /** Desktop: offset last-row cards for centering in a 6-col grid */
  centerStart?: boolean
}

const { project, index, centerStart = false } = Astro.props
const noteNum = String(index + 1).padStart(2, '0')
---

<button
  type="button"
  class:list={[
    'project-row group focus-ink flex h-full w-full cursor-pointer flex-col border border-(--ink)/35 bg-(--paper) p-4 text-left transition-colors duration-300 hover:border-(--ink)/60 sm:p-5',
    'lg:col-span-2',
    centerStart && 'lg:col-start-2',
  ]}
  data-project-index={index}
>
  <!-- Diagram -->
  <div
    class="mb-4 border border-(--ink-faint) bg-(--paper-dark)/40 px-2 py-3 transition-transform duration-300 ease-out group-hover:-translate-y-0.5"
  >
    <ProjectDiagram title={project.title} />
  </div>

  <p
    class="mb-1.5 font-mono text-[10px] tracking-[0.2em] text-(--ink) uppercase"
  >
    {noteNum}
  </p>

  <h3
    class="font-display mb-2 text-[1.2rem] leading-snug tracking-tight text-(--ink-deep) transition-colors group-hover:text-(--ink)"
  >
    {project.title}
  </h3>

  <p class="mb-3 line-clamp-3 text-[13px] leading-relaxed text-(--ink-deep)">
    {project.desc}
  </p>

  <div class="mt-auto border-t border-(--ink-faint) pt-3">
    <span
      class="inline-flex items-center font-mono text-[11px] tracking-[0.14em] text-(--ink) uppercase"
    >
      {project.github ? 'GitHub' : 'Open'}
      <span
        class="ml-1.5 inline-block transition-transform duration-300 ease-out group-hover:translate-x-1"
        aria-hidden="true"
        >→</span
      >
    </span>
  </div>
</button>
