---
import Section from '../../layout/Section.astro'
import SocialLinks from '../../layout/SocialLinks.astro'
---

<Section
  id="contact"
  kicker="Field Notes / 006"
  heading="Have an idea? Let's build it."
>
  <div class="relative max-w-2xl">
    <p class="mb-8 max-w-lg text-[15px] leading-relaxed text-(--ink-deep)/80">
      I’m always open to discussing new projects, creative ideas, or
      opportunities to be part of your visions. Feel free to reach out.
    </p>

    <SocialLinks />

    <p
      class="font-hand mt-10 text-[1.2rem] text-(--ink)"
      aria-hidden="true"
    >
      last page leave a mark
    </p>
  </div>
</Section>

<style>
  .contact-cta__path {
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    transform-origin: center;
  }

  .contact-cta:hover .contact-cta__path,
  .contact-cta:focus-visible .contact-cta__path {
    transform: scale(1.02) rotate(-0.5deg);
  }
</style>
