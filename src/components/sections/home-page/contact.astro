---
import Section from '../../layout/Section.astro'
import SocialLinks from '../../layout/SocialLinks.astro'
import { SketchAnnotation } from '../../sketch'
---

<Section
  id="contact"
  title="Contact"
  heading="Let's connect"
>
  <div class="relative max-w-xl">
    <SketchAnnotation
      label="open channel"
      class="absolute -top-2 -right-4 hidden sm:block"
      rotate={6}
    />
    <p
      class="mb-6 text-[15px] leading-relaxed text-[color-mix(in_srgb,var(--ink-deep)_78%,#64748b)]"
    >
      I’m always open to discussing new projects, creative ideas, or
      opportunities to be part of your visions. Feel free to reach out.
    </p>
    <SocialLinks />
  </div>
</Section>
