---
import Section from '../../layout/Section.astro'
import { MetaLabel, Divider } from '../../ui'
import { achievements } from '../../../data/navigation'
import { TechnicalDiagram, SketchAnnotation } from '../../sketch'
---

<Section
  id="about"
  title="About"
  heading="A bit about me"
>
  <div class="grid gap-12 lg:grid-cols-5">
    <div class="space-y-5 lg:col-span-3">
      <p
        class="text-[15px] leading-[1.8] text-[color-mix(in_srgb,var(--ink-deep)_78%,#64748b)]"
      >
        I’m a frontend-focused full-stack developer with experience building
        scalable, production-grade web applications. Currently, I work on an
        AI-driven Governance, Risk & Compliance (GRC) platform, where I design
        and develop complex user interfaces, data-driven dashboards, and
        reusable component systems.
      </p>
      <p
        class="text-[15px] leading-[1.8] text-[color-mix(in_srgb,var(--ink-deep)_78%,#64748b)]"
      >
        I enjoy solving problems that sit at the intersection of performance,
        usability, and system design — turning complex workflows into simple,
        intuitive user experiences. While I’ve explored areas like Web3 and AI
        through projects, my core strength lies in building <strong
          class="font-semibold text-[var(--ink-deep)]"
          >reliable, maintainable, and scalable web systems.</strong
        >
      </p>

      <div class="pt-6">
        <MetaLabel class="mb-3">Contributions</MetaLabel>
        <a
          href="https://github.com/adarshswaminath"
          target="_blank"
          rel="noopener"
          class="focus-ink block overflow-x-auto"
        >
          <img
            src="https://ghchart.rshah.org/174A91/adarshswaminath"
            alt="GitHub Contribution Graph"
            class="w-full opacity-85 transition-opacity duration-300 hover:opacity-100"
            loading="lazy"
          />
        </a>
      </div>
    </div>

    <div class="relative space-y-8 lg:col-span-2">
      <div>
        <MetaLabel class="mb-3">Expertise</MetaLabel>
        <ul class="space-y-2">
          {
            [
              'Frontend Engineering',
              'System-Driven UI Development',
              'Developer Experience',
            ].map((expertise) => (
              <li class="flex items-start gap-2 text-[14px] text-[color-mix(in_srgb,var(--ink-deep)_75%,#64748b)]">
                <span
                  class="mt-2 h-1 w-1 shrink-0 rounded-full bg-[var(--ink)]"
                  aria-hidden="true"
                />
                {expertise}
              </li>
            ))
          }
        </ul>
      </div>

      <Divider />

      <div>
        <MetaLabel class="mb-3">Focus Areas</MetaLabel>
        <ul class="space-y-2">
          {
            [
              'Performance-first architecture',
              'Clean, maintainable systems',
              'Scalable component systems',
              'Developer productivity & tooling',
            ].map((focusArea) => (
              <li class="flex items-start gap-2 text-[14px] text-[color-mix(in_srgb,var(--ink-deep)_75%,#64748b)]">
                <span
                  class="mt-2 h-1 w-1 shrink-0 rounded-full bg-[var(--ink-muted)]"
                  aria-hidden="true"
                />
                {focusArea}
              </li>
            ))
          }
        </ul>
      </div>

      <Divider />

      <div>
        <MetaLabel class="mb-3">Recognition</MetaLabel>
        <ul class="space-y-2">
          {
            achievements.map((a) => (
              <li class="flex items-start gap-2 text-[13px] text-[var(--ink-muted)]">
                <span
                  class="mt-2 h-1 w-1 shrink-0 rounded-full bg-[var(--ink-muted)]"
                  aria-hidden="true"
                />
                {a}
              </li>
            ))
          }
        </ul>
      </div>

      <!-- <div class="relative pt-4">
        <SketchAnnotation
          label="things I like building"
          class="mb-2"
          rotate={-3}
        />
        <TechnicalDiagram
          compact
          class="opacity-90"
        />
      </div> -->
    </div>
  </div>
</Section>
