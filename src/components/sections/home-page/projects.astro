---
import Section from '../../layout/Section.astro'
import { ProjectCard } from '../../ui'
import ProjectDrawer from '../../layout/ProjectDrawer.astro'
import { projects } from '../../../data/projects'
import TreasureChest from '@/components/sketch/TreasureChest.astro'

const entries = projects.slice(0, 5)
---

<Section
  id="projects"
  kicker="Field Notes / 002"
  heading="Selected work"
>
  <TreasureChest
    slot="margin"
    variant="margin"
    artifactId="treasure-chest-projects"
  />
  <div class="relative mb-10">
    <p class="max-w-xl text-[14px] leading-relaxed text-(--ink-muted)">
      Case studies from systems I’ve built recorded like engineering notebook
      entries.
    </p>

    <!-- Sparse section annotations -->
    <p
      class="font-hand mt-3 hidden text-[1.1rem] text-(--ink) md:block"
      aria-hidden="true"
    >
      five artifacts on the bench
    </p>
  </div>

  <!--
    lg: 6-col grid, each card spans 2 → three per row.
    Cards 4–5 use col-start-2 / natural flow so the last row is centered.
  -->
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-6 lg:gap-7">
    {
      entries.map((p, i) => (
        <ProjectCard
          project={p}
          index={i}
          centerStart={i === 3}
        />
      ))
    }
  </div>
</Section>

<ProjectDrawer projects={projects} />
