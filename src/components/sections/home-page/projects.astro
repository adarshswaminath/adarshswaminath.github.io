---
// projects.astro
import Section from '../../layout/Section.astro'
import { ProjectCard } from '../../ui'
import ProjectDrawer from '../../layout/ProjectDrawer.astro'
import { projects } from '../../../data/projects'
---

<Section
  id="projects"
  title="Field Notes"
  heading="Selected work"
>
  <p class="mb-8 max-w-xl text-[14px] leading-relaxed text-[var(--ink-muted)]">
    Case studies from systems I’ve built — recorded like engineering notebook
    entries.
  </p>
  <div class="-mx-2 flex flex-wrap md:mx-0">
    {
      projects.slice(0, 6).map((p, i) => (
        <div class="w-full p-2 md:w-1/2 lg:w-1/3">
          <ProjectCard
            project={p}
            index={i}
          />
        </div>
      ))
    }
  </div>
</Section>

<ProjectDrawer projects={projects} />
