---
import Section from '../../layout/Section.astro'
import { ProjectCard } from '../../ui'
import ProjectDrawer from '../../layout/ProjectDrawer.astro'
import { projects } from '../../../data/projects'

const entries = projects.slice(0, 5)
---

<Section
  id="projects"
  kicker="Field Notes / 002"
  heading="Selected work"
>
  <div class="relative mb-10">
    <p class="max-w-xl text-[14px] leading-relaxed text-(--ink-muted)">
      Case studies from systems I’ve built recorded like engineering notebook
      entries.
    </p>

    <!-- Sparse section annotations -->
    <p
      class="pointer-events-none absolute top-0 right-0 hidden font-mono text-[9px] tracking-wider text-(--ink)/40 lg:block"
      aria-hidden="true"
    >
      SYSTEM 01
    </p>
    <p
      class="font-hand mt-3 hidden text-[1.1rem] text-(--ink)/50 md:block"
      aria-hidden="true"
    >
      five artifacts on the bench
    </p>
  </div>

  <!--
    lg: 6-col grid, each card spans 2 → three per row.
    Cards 4–5 use col-start-2 / natural flow so the last row is centered.
  -->
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-6 lg:gap-7">
    {
      entries.map((p, i) => (
        <ProjectCard
          project={p}
          index={i}
          centerStart={i === 3}
        />
      ))
    }
  </div>

  <!-- Tiny measurement mark -->
  <svg
    class="mx-auto mt-10 hidden h-3 w-32 text-(--ink)/35 md:block"
    viewBox="0 0 128 12"
    fill="none"
    aria-hidden="true"
  >
    <path
      d="M2,8 L126,8"
      stroke="currentColor"
      stroke-width="1"
      stroke-linecap="round"
    ></path>
    <path
      d="M2,4 L2,10 M32,5 L32,10 M64,3 L64,11 M96,5 L96,10 M126,4 L126,10"
      stroke="currentColor"
      stroke-width="1"
      stroke-linecap="round"
    ></path>
  </svg>
</Section>

<ProjectDrawer projects={projects} />
