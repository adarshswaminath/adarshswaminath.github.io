---
import { Tag } from '../../ui'
import CodeWindow from '../../layout/CodeWindow.astro'
import { stackTags } from '../../../data/navigation'
const socialLinks = [
  {
    label: 'github',
    link: 'https://github.com/adarshswaminath',
    icon: '/github-icon.svg',
  },
  {
    label: 'linkedin',
    link: 'https://www.linkedin.com/in/adarshswaminath/',
    icon: '/linkedin-icon.svg',
  },
  {
    label: 'twitter',
    link: 'https://x.com/adarshswaminath',
    icon: '/twitter-icon.svg',
  },
  {
    label: 'medium',
    link: 'https://medium.com/@adarshswaminath7',
    icon: '/medium-icon.svg',
  },
]
---

<section class="mx-auto max-w-5xl px-6 py-20 md:py-32">
  <h1
    class="mb-5 text-4xl leading-tight font-semibold tracking-tight text-slate-900 md:text-5xl"
  >
    Building scalable, user-focused web applications
  </h1>
  <p class="mb-8 max-w-2xl text-lg text-slate-600">
    Focused on performance, clean architecture, and developer experience.
  </p>
  <div class="mb-8 flex gap-4">
    {
      socialLinks.map((link) => (
        <a
          href={link.link}
          target="_blank"
          rel="noopener noreferrer"
        >
          <img
            src={link.icon}
            alt={link.label}
            width={35}
            height={35}
          />
        </a>
      ))
    }
  </div>

  <div class="mb-4">
    <CodeWindow
      title="stack.ts"
      code={`const engineer = {
  name: "Adarsh",
  currently: "building AI-powered platforms",
  focus: [
    "scalable systems",
    "developer tooling",
    "clarity over complexity",
  ]
}

// let's build something great`}
      class="max-w-2xl"
    />
  </div>

  <div class="mt-6 flex flex-wrap gap-2">
    {stackTags.map((t) => <Tag>{t}</Tag>)}
  </div>
</section>
