---
import Section from '../../layout/Section.astro'
import type { MarkdownPost } from '../../../data/types'

interface Props {
  posts: MarkdownPost[]
}

const { posts } = Astro.props
---

<Section
  id="blog"
  kicker="Field Notes / 005"
  heading="Writing & thoughts"
>
  <div class="mb-8 space-y-0">
    {
      posts.map((post, i) => (
        <a
          href={post.url}
          class="group row-hover-sheen focus-ink -mx-4 block w-full border-b border-(--ink-faint) px-4 py-5 text-left"
        >
          <span
            class="row-hover-sheen__fill"
            aria-hidden="true"
          />
          <div class="relative z-10 flex items-center justify-between gap-6">
            <div class="min-w-0 flex-1">
              <div class="mb-1.5 flex flex-wrap items-center gap-x-3 gap-y-1">
                <span class="shrink-0 font-mono text-[10px] font-medium tracking-[0.18em] text-(--ink) uppercase">
                  Note / {String(posts.length - i).padStart(3, '0')}
                </span>
                <span class="hidden font-mono text-[10px] tracking-[0.12em] text-(--ink-muted) uppercase sm:inline">
                  {post.frontmatter.category || 'Article'}
                </span>
              </div>
              <h3 class="truncate text-[15px] font-medium text-(--ink-deep) transition-colors group-hover:text-(--ink)">
                {post.frontmatter.title}
              </h3>
              <p class="mt-1 truncate text-[13px] leading-relaxed text-(--ink-muted)">
                {post.frontmatter.description}
              </p>
            </div>
            <div class="flex shrink-0 flex-col items-end gap-2">
              <span class="hidden font-mono text-[11px] text-(--ink-muted) md:block">
                {new Date(post.frontmatter.date).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
              </span>
              <span class="sketch-link font-mono text-[10px] tracking-[0.12em] uppercase">
                → Read
              </span>
            </div>
          </div>
        </a>
      ))
    }
  </div>
  <a
    href="/blog"
    class="sketch-link focus-ink font-mono text-[12px] tracking-[0.14em] uppercase"
  >
    → View all notes
  </a>
</Section>
