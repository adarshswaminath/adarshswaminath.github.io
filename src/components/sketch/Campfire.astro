---
/**
 * Interactive expedition campfire — click to light / douse.
 */
import SketchArtifact from './SketchArtifact.astro'
import type { SketchArtifactVariant } from '../../data/sketch-artifacts'

interface Props {
  variant?: SketchArtifactVariant
  artifactId?: string
}

const { variant = 'margin', artifactId = 'campfire-artifact' } = Astro.props
---

<SketchArtifact
  preset="campfire"
  variant={variant}
  artifactId={artifactId}
>
  <svg
    class="campfire__svg group pointer-events-none block size-full overflow-visible object-contain select-none"
    viewBox="0 0 48 48"
    aria-hidden="true"
    focusable="false"
    shape-rendering="crispEdges"
  >
    <g class="campfire__logs">
      <path
        fill="#57372b"
        d="M12 32h6v2h8v2h10v5h-8v-2h-8v-2h-8z"
      ></path>
      <path
        fill="#885437"
        d="M30 32h6v5h-8v2h-8v2h-8v-5h10v-2h8z"
      ></path>
      <path
        fill="#b57b48"
        d="M13 36h7v2h-7z M28 33h6v2h-6z"
      ></path>
      <path
        fill="#39291f"
        d="M13 38h3v2h-3z M32 38h3v2h-3z"
      ></path>
    </g>

    <g class="campfire__flame">
      <g>
        <animate
          attributeName="opacity"
          values="1;0;1;0;1"
          keyTimes="0;.25;.5;.75;1"
          calcMode="discrete"
          dur=".9s"
          repeatCount="indefinite"
        ></animate>
        <path
          fill="#ed6235"
          d="M22 12h4v6h4v5h4v9h-4v3H18v-3h-4v-7h4v-6h4z"
        ></path>
        <path
          fill="#ffac3d"
          d="M22 20h4v5h4v7h-4v2h-6v-3h-3v-5h5z"
        ></path>
        <path
          fill="#ffe68b"
          d="M23 26h3v4h2v3h-7v-4h2z"
        ></path>
      </g>
      <g opacity="0">
        <animate
          attributeName="opacity"
          values="0;1;0;1;0"
          keyTimes="0;.25;.5;.75;1"
          calcMode="discrete"
          dur=".9s"
          repeatCount="indefinite"
        ></animate>
        <path
          fill="#ed6235"
          d="M25 11h4v9h3v6h3v6h-5v3H18v-3h-4v-9h4v-5h3v7h4z"
        ></path>
        <path
          fill="#ffac3d"
          d="M25 20h3v7h3v5h-5v2h-6v-3h-3v-5h5v-3h3z"
        ></path>
        <path
          fill="#ffe68b"
          d="M24 26h3v5h2v2h-8v-4h3z"
        ></path>
      </g>
      <rect
        x="20"
        y="17"
        width="2"
        height="2"
        fill="#ffc45b"
      >
        <animate
          attributeName="y"
          values="17;6"
          dur="1.8s"
          repeatCount="indefinite"
        ></animate>
        <animate
          attributeName="x"
          values="20;18;20"
          dur="1.8s"
          repeatCount="indefinite"
        ></animate>
        <animate
          attributeName="opacity"
          values="0;1;1;0"
          keyTimes="0;.15;.6;1"
          dur="1.8s"
          repeatCount="indefinite"
        ></animate>
      </rect>
    </g>

    <g
      class="campfire__embers"
      opacity="0.55"
    >
      <rect
        x="21"
        y="29"
        width="2"
        height="2"
        fill="currentColor"
      ></rect>
      <rect
        x="26"
        y="27"
        width="1"
        height="1"
        fill="currentColor"
      ></rect>
    </g>
  </svg>
</SketchArtifact>

<style>
  .campfire__svg {
    width: 6.5rem;
    height: 6.5rem;
    transition: transform 0.2s ease;
  }

  :global(.sketch-artifact--campfire .sketch-artifact__box:hover)
    .campfire__svg,
  :global(.sketch-artifact--campfire.is-lit .sketch-artifact__box:hover)
    .campfire__svg {
    transform: translateY(-2px);
  }

  :global(.sketch-artifact--campfire .sketch-artifact__box:active)
    .campfire__svg {
    transform: scale(0.95);
  }

  .campfire__flame {
    opacity: 0;
    transform: scale(0.55);
    transform-origin: 24px 35px;
    filter: none;
    transition:
      opacity 180ms ease,
      transform 220ms ease,
      filter 180ms ease;
  }

  .campfire__embers {
    color: var(--ink-muted, #6b6358);
    transition: opacity 180ms ease;
  }

  :global(.sketch-artifact--campfire.is-lit) .campfire__flame {
    opacity: 1;
    transform: scale(1);
    filter: drop-shadow(rgb(237, 98, 53) 0px 0px 2px);
  }

  :global(.sketch-artifact--campfire.is-lit) .campfire__embers {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .campfire__flame,
    .campfire__embers,
    .campfire__svg {
      transition: none;
    }

    :global(.sketch-artifact--campfire .sketch-artifact__box:hover)
      .campfire__svg,
    :global(.sketch-artifact--campfire .sketch-artifact__box:active)
      .campfire__svg {
      transform: none;
    }

    .campfire__flame animate {
      display: none;
    }
  }
</style>
