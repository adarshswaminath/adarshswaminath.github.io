---
/**
 * Interactive expedition campfire — click to light / douse.
 * `margin` — notebook gutter beside a section (e.g. projects).
 * `divider` — anchored to an expedition SketchDivider.
 */
interface Props {
  variant?: 'margin' | 'divider'
  artifactId?: string
}

const { variant = 'margin', artifactId = 'campfire-artifact' } = Astro.props

const fireSize =
  variant === 'margin'
    ? 'h-[5.25rem] w-28 xl:h-[6rem] xl:w-32'
    : 'h-20 w-20 xl:h-24 xl:w-24'

const clusterPosition =
  variant === 'margin'
    ? 'absolute top-[52%] left-6 w-max -translate-x-[calc(100%+0.75rem)] -translate-y-1/2 xl:left-8 xl:-translate-x-[calc(100%+1.25rem)]'
    : 'absolute left-6 bottom-0 mb-1.5 w-max xl:left-8'
---

<div
  class="campfire-root pointer-events-none absolute inset-0 z-20 hidden lg:block"
  data-campfire
>
  <div class="relative mx-auto h-full w-full max-w-5xl px-6">
    <div
      class={`pointer-events-auto flex flex-col items-center gap-1 text-(--ink) ${clusterPosition}`}
      data-campfire-cluster
    >
      <div
        id={artifactId}
        class={`campfire__box ${fireSize} shrink-0 cursor-pointer`}
        data-campfire-box
        role="img"
        aria-label="Campfire, currently out"
      >
        <svg
          class="campfire__svg group pointer-events-none block size-full select-none overflow-visible object-contain"
          viewBox="0 0 48 48"
          aria-hidden="true"
          focusable="false"
          shape-rendering="crispEdges"
          data-campfire-svg
        >
          <!-- Logs (always visible) -->
          <g class="campfire__logs">
            <path
              fill="#57372b"
              d="M12 32h6v2h8v2h10v5h-8v-2h-8v-2h-8z"></path>
            <path
              fill="#885437"
              d="M30 32h6v5h-8v2h-8v2h-8v-5h10v-2h8z"></path>
            <path fill="#b57b48" d="M13 36h7v2h-7z M28 33h6v2h-6z"></path>
            <path fill="#39291f" d="M13 38h3v2h-3z M32 38h3v2h-3z"></path>
          </g>

          <!-- Flames + ember spark (lit state) -->
          <g class="campfire__flame" data-campfire-flame>
            <g>
              <animate
                attributeName="opacity"
                values="1;0;1;0;1"
                keyTimes="0;.25;.5;.75;1"
                calcMode="discrete"
                dur=".9s"
                repeatCount="indefinite"></animate>
              <path
                fill="#ed6235"
                d="M22 12h4v6h4v5h4v9h-4v3H18v-3h-4v-7h4v-6h4z"></path>
              <path
                fill="#ffac3d"
                d="M22 20h4v5h4v7h-4v2h-6v-3h-3v-5h5z"></path>
              <path fill="#ffe68b" d="M23 26h3v4h2v3h-7v-4h2z"></path>
            </g>
            <g opacity="0">
              <animate
                attributeName="opacity"
                values="0;1;0;1;0"
                keyTimes="0;.25;.5;.75;1"
                calcMode="discrete"
                dur=".9s"
                repeatCount="indefinite"></animate>
              <path
                fill="#ed6235"
                d="M25 11h4v9h3v6h3v6h-5v3H18v-3h-4v-9h4v-5h3v7h4z"></path>
              <path
                fill="#ffac3d"
                d="M25 20h3v7h3v5h-5v2h-6v-3h-3v-5h5v-3h3z"></path>
              <path fill="#ffe68b" d="M24 26h3v5h2v2h-8v-4h3z"></path>
            </g>
            <rect x="20" y="17" width="2" height="2" fill="#ffc45b">
              <animate
                attributeName="y"
                values="17;6"
                dur="1.8s"
                repeatCount="indefinite"></animate>
              <animate
                attributeName="x"
                values="20;18;20"
                dur="1.8s"
                repeatCount="indefinite"></animate>
              <animate
                attributeName="opacity"
                values="0;1;1;0"
                keyTimes="0;.15;.6;1"
                dur="1.8s"
                repeatCount="indefinite"></animate>
            </rect>
          </g>

          <!-- Cold ash / smoke dots when unlit -->
          <g class="campfire__embers" data-campfire-embers opacity="0.55">
            <rect x="21" y="29" width="2" height="2" fill="currentColor"
            ></rect>
            <rect x="26" y="27" width="1" height="1" fill="currentColor"
            ></rect>
          </g>
        </svg>
      </div>

      <div class="campfire__hint text-center" data-campfire-hint>
        <button
          type="button"
          class="campfire__trigger focus-ink font-hand max-w-38 cursor-pointer bg-transparent p-0 text-[clamp(1rem,1.05vw,1.2rem)] leading-[1.15] text-(--ink)"
          data-campfire-trigger
          aria-pressed="false"
          aria-controls={artifactId}
          aria-label="Light the campfire"
        >
          <span data-campfire-label>[light the campfire]</span>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .campfire__trigger {
    opacity: 0.78;
    transform: rotate(2.5deg);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }

  .campfire__trigger:hover,
  .campfire__trigger:focus-visible {
    opacity: 1;
    transform: rotate(2.5deg) translateY(-1px);
  }

  .campfire__trigger:hover [data-campfire-label],
  .campfire__trigger:focus-visible [data-campfire-label] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--ink) 45%, transparent);
  }

  .campfire__box {
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .campfire__svg {
    width: 6.5rem;
    height: 6.5rem;
    transition: transform 0.2s ease;
  }

  .campfire__box:hover .campfire__svg,
  .campfire-root.is-lit .campfire__box:hover .campfire__svg {
    transform: translateY(-2px);
  }

  .campfire__box:active .campfire__svg {
    transform: scale(0.95);
  }

  .campfire__flame {
    opacity: 0;
    transform: scale(0.55);
    transform-origin: 24px 35px;
    filter: none;
    transition:
      opacity 180ms ease,
      transform 220ms ease,
      filter 180ms ease;
  }

  .campfire__embers {
    color: var(--ink-muted, #6b6358);
    transition: opacity 180ms ease;
  }

  .campfire-root.is-lit .campfire__flame {
    opacity: 1;
    transform: scale(1);
    filter: drop-shadow(rgb(237, 98, 53) 0px 0px 2px);
  }

  .campfire-root.is-lit .campfire__embers {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .campfire__flame,
    .campfire__embers,
    .campfire__svg,
    .campfire__trigger {
      transition: none;
    }

    .campfire__box:hover .campfire__svg,
    .campfire__box:active .campfire__svg {
      transform: none;
    }

    .campfire__flame animate {
      display: none;
    }
  }
</style>

<script>
  import { setupCampfire } from '../../scripts/campfire'

  setupCampfire()
  document.addEventListener('astro:page-load', setupCampfire)
</script>
