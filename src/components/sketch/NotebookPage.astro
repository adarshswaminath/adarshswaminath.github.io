---
interface Props {
  class?: string
  ruled?: boolean
}
const { class: className = '', ruled = false } = Astro.props
---

<div class={`relative bg-(--paper) ${className}`}>
  {
    ruled && (
      <div
        class="pointer-events-none absolute inset-0 opacity-[0.07]"
        style="background-image:repeating-linear-gradient(to bottom, transparent, transparent 27px, var(--ink) 27px, var(--ink) 28px)"
        aria-hidden="true"
      />
    )
  }
  <div class="relative z-10">
    <slot />
  </div>
</div>
