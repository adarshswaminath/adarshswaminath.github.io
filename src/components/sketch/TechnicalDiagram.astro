---
/**
 * Compact blue-ink architecture sketch for hero / about.
 */
interface Props {
  class?: string
  compact?: boolean
}
const { class: className = '', compact = false } = Astro.props
---

<figure class={`relative ${className}`}>
  <svg
    viewBox="0 0 320 280"
    class="h-auto w-full"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="Hand-drawn software architecture diagram"
  >
    <!-- Outer notebook frame -->
    <path
      class="ink-stroke-muted"
      d="M12,14 C90,10 200,12 308,16 C310,80 309,180 306,266 C220,270 100,268 14,264 C10,180 11,80 12,14 Z"
      opacity="0.55"
    ></path>

    <!-- API box -->
    <path
      class="ink-stroke"
      d="M98,28 C130,26 190,27 222,30 C224,42 223,54 221,66 C180,69 130,68 100,65 C97,52 97,40 98,28 Z"
    ></path>
    <text
      x="160"
      y="52"
      text-anchor="middle"
      class="font-mono"
      fill="var(--ink)"
      font-size="13"
      font-family="JetBrains Mono, monospace"
      letter-spacing="0.12em"
      >API</text
    >

    <!-- Arrow down -->
    <path
      class="ink-stroke"
      d="M160,72 C159,86 161,98 160,112 M152,102 C156,108 159,111 160,113 C162,110 166,105 169,101"
    ></path>

    <!-- SERVICE box -->
    <path
      class="ink-stroke"
      d="M78,118 C120,115 200,116 242,120 C244,138 243,156 240,172 C190,176 120,175 80,171 C76,152 76,134 78,118 Z"
    ></path>
    <text
      x="160"
      y="150"
      text-anchor="middle"
      fill="var(--ink)"
      font-size="13"
      font-family="JetBrains Mono, monospace"
      letter-spacing="0.1em"
      >SERVICE</text
    >

    <!-- Branch arrows -->
    <path
      class="ink-stroke"
      d="M120,176 C100,190 78,204 62,218"
    ></path>
    <path
      class="ink-stroke"
      d="M160,176 C160,190 160,204 160,220"
    ></path>
    <path
      class="ink-stroke"
      d="M200,176 C220,190 242,204 258,218"
    ></path>

    <!-- DB cylinder -->
    <ellipse
      class="ink-stroke"
      cx="62"
      cy="228"
      rx="28"
      ry="8"
    ></ellipse>
    <path
      class="ink-stroke"
      d="M34,228 L34,248 C34,253 46,256 62,256 C78,256 90,253 90,248 L90,228"
    ></path>
    <text
      x="62"
      y="242"
      text-anchor="middle"
      fill="var(--ink)"
      font-size="11"
      font-family="JetBrains Mono, monospace"
      >DB</text
    >

    <!-- CACHE box -->
    <path
      class="ink-stroke"
      d="M132,226 C145,224 170,225 188,228 C189,238 188,248 186,256 C165,259 145,258 134,255 C131,245 131,235 132,226 Z"
    ></path>
    <text
      x="160"
      y="245"
      text-anchor="middle"
      fill="var(--ink)"
      font-size="11"
      font-family="JetBrains Mono, monospace"
      >CACHE</text
    >

    <!-- AI node -->
    <circle
      class="ink-stroke"
      cx="258"
      cy="240"
      r="22"
    ></circle>
    <text
      x="258"
      y="244"
      text-anchor="middle"
      fill="var(--ink)"
      font-size="11"
      font-family="JetBrains Mono, monospace"
      >AI</text
    >

    {
      !compact && (
        <text
          x="230"
          y="88"
          fill="var(--ink)"
          font-size="16"
          font-family="Caveat, cursive"
          transform="rotate(-8 230 88)"
          opacity="0.9"
        >
          architecture matters
        </text>
      )
    }
  </svg>
</figure>
