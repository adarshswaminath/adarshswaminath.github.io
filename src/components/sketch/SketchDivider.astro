---
/**
 * Hand-drawn ink divider between notebook sections.
 * Optional expedition checkpoint flag (planted by expedition-trail.ts).
 */
interface Props {
  class?: string
  /** Section id this divider marks as an expedition checkpoint */
  flagFor?: string
}
const { class: className = '', flagFor } = Astro.props
---

<div
  class={`sketch-divider relative my-1 flex w-full items-center justify-center px-6 ${className}`}
  data-expedition-checkpoint={flagFor}
  aria-hidden="true"
>
  <div class="relative w-full max-w-5xl">
    <svg
      class="h-5 w-full text-(--ink-muted)"
      viewBox="0 0 800 20"
      preserveAspectRatio="none"
      fill="none"
    >
      <path
        d="M8,10.5 C80,7.5 160,13.5 240,9 C320,4.5 400,14 480,9.5 C560,5 640,12.5 720,8.5 C750,7 780,11 792,9.5"
        stroke="currentColor"
        stroke-width="1.2"
        stroke-linecap="round"
        fill="none"
        opacity="0.55"
      ></path>
      <!-- measurement ticks -->
      <path
        d="M200,6 L200,14 M400,4 L400,16 M600,6 L600,14"
        stroke="currentColor"
        stroke-width="1"
        stroke-linecap="round"
        opacity="0.4"
      ></path>
    </svg>

    {
      flagFor && (
        <span
          class="expedition-flag pointer-events-none absolute top-0 bottom-0 left-[3%] hidden  lg:block"
          data-expedition-flag
        >
          <svg
            class="expedition-flag__svg"
            viewBox="0 0 18 22"
            width="22"
            height="27"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <!-- thin pole -->
            <path
              d="M3.2 1.2 C3.15 7.5 3.25 14.2 3.3 20.6"
              stroke="var(--ink-deep)"
              stroke-width="1.05"
              stroke-linecap="round"
              opacity="0.7"
            ></path>
            <!-- small red field flag -->
            <path
              class="expedition-flag__cloth"
              d="
                M3.5 2.1
                C6.8 1.6 10.2 2.0 13.6 1.5
                C12.4 3.4 12.6 5.2 13.5 7.0
                C10.0 6.6 6.8 7.0 3.5 6.4
                Z
              "
              fill="var(--annotation)"
              fill-opacity="0.88"
              stroke="var(--annotation)"
              stroke-width="0.9"
              stroke-linejoin="round"
            ></path>
          </svg>
        </span>
      )
    }
  </div>
</div>

<style>
  .expedition-flag {
    opacity: 0;
    transform: translateY(calc(-85% + 5px)) scale(0.7);
    transform-origin: 20% 100%;
    transition:
      opacity 0.35s ease,
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .expedition-flag.is-planted {
    opacity: 1;
    transform: translateY(-85%) scale(1);
  }

  .expedition-flag__cloth {
    transform-origin: 3.5px 4px;
  }

  .expedition-flag.is-planted .expedition-flag__cloth {
    animation: expedition-flag-wave 2.8s ease-in-out infinite;
  }

  @keyframes expedition-flag-wave {
    0%,
    100% {
      transform: skewX(0deg);
    }
    50% {
      transform: skewX(-4deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .expedition-flag {
      transition-duration: 0.01ms;
    }

    .expedition-flag.is-planted .expedition-flag__cloth {
      animation: none;
    }
  }
</style>
