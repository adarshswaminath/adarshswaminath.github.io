---
interface Props {
  class?: string
  label: string
  rotate?: number
}
const { class: className = '', label, rotate = -6 } = Astro.props
---

<span
  class={`font-hand inline-block text-[1.15rem] leading-none text-[var(--ink)] ${className}`}
  style={`transform: rotate(${rotate}deg)`}
>
  {label}
</span>
